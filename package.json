        {
          "file": "images/icon_color.png",
          "type": "png",
          "name": "MENU_ICON",
          "targetPlatforms": [
            "basalt",
            "chalk",
            "emery",
            "gabbro"
          ]
        },
        {
          "type": "font",
          "name": "BEBAS_FONT_35",
          "file": "fonts/bebas_neue_regular.ttf",
          "characterRegex": "[0-9: ]"
